<item>
    <title>提示词工程学习笔记</title>
    <link>http://findtreasureisland.github.io/%E6%8F%90%E7%A4%BA%E8%AF%8D%E5%B7%A5%E7%A8%8B%E5%AD%A6%E4%B9%A0%E7%AC%94%E8%AE%B0/</link>
