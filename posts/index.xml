    <item>
      <title>好奇害死猫系列：Anthropic系统提示词分析和拆解</title>
      <link>http://findtreasureisland.github.io/%E5%A5%BD%E5%A5%87%E5%AE%B3%E6%AD%BB%E7%8C%AB%E7%B3%BB%E5%88%97anthropic%E7%B3%BB%E7%BB%9F%E6%8F%90%E7%A4%BA%E8%AF%8D%E5%88%86%E6%9E%90%E5%92%8C%E6%8B%86%E8%A7%A3/</link>
